# Offline demo defaults. Start with ./scripts/dev.sh (reads .env if present).
DW_DATA=data/generated
DW_RUNTIME=runtime
DW_LLM=mock
DW_ASR=replay
DW_DEMO=0
DW_MAX_BODY_BYTES=33554432
DW_LLM_CACHE_ON=1

# Optional authentication: use distinct random tokens supplied through environment.
# DW_ADMIN_TOKEN=
# DW_REVIEWER_TOKEN=
DW_ADMIN_NAME=Administrator
DW_REVIEWER_NAME=Compliance Reviewer
# Set to 1 when serving over HTTPS behind a correctly configured reverse proxy.
DW_COOKIE_SECURE=0
# Backend deployments: comma-separated exact HTTPS frontend origins, no wildcards.
# DW_PUBLIC_ORIGINS=https://your-frontend.vercel.app
# Vercel build only: durable backend's HTTPS origin.
# DW_BACKEND_URL=https://your-aws-backend.example.com

# Optional local inference. Install a model in Ollama, then choose its exact name.
# DW_LLM=ollama
# DW_LLM_MODEL=gemma4:e2b
# Optional hosted inference; use your own provider credentials.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional real ASR; replay transcripts remain the offline default.
# SARVAM_API_KEY=
